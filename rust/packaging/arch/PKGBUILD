# Maintainer: Rippa The Hutt <iacoporippagmail@duck.com>
# Builds the Rust port (mcomix-rs) straight from the project's git tag:
#
#   makepkg -si
#
# (pkgver must match an existing tag in the repository, e.g. v0.1.0)

pkgname=mcomix-rs
pkgver=0.1.0
pkgrel=1
pkgdesc="A user-friendly, customizable comic book image viewer (Rust/GTK4 port)"
arch=('x86_64' 'aarch64')
url="https://github.com/rippa-the-hutt/mcomix-rs"
license=('GPL2')
depends=(
    'gtk4'
    'gdk-pixbuf2'
    'glib2'
    'pango'
    'cairo'
    'liblzma'
    'bzip2'
)
optdepends=(
    'unrar: for CBR/RAR archive support'
    'p7zip: for 7Zip/LHA archive support'
    'mupdf-tools: for PDF support'
)
makedepends=(
    'git'
    'rust'
    'pkg-config'
    'desktop-file-utils'
    'shared-mime-info'
)
# Fetch the source from the git tag (the crate lives in rust/).
source=("mcomix-rs::git+https://github.com/rippa-the-hutt/mcomix-rs.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/mcomix-rs/rust"
    cargo fetch --locked
}

build() {
    cd "${srcdir}/mcomix-rs/rust"
    cargo build --release --locked
}

check() {
    cd "${srcdir}/mcomix-rs/rust"
    cargo test --release --locked
}

package() {
    cd "${srcdir}/mcomix-rs/rust"

    install -Dm755 target/release/mcomix-rs "${pkgdir}/usr/bin/mcomix-rs"

    install -Dm644 packaging/linux/mcomix-rs.desktop \
        "${pkgdir}/usr/share/applications/mcomix-rs.desktop"
    install -Dm644 packaging/linux/mcomix-rs.xml \
        "${pkgdir}/usr/share/mime/packages/mcomix-rs.xml"

    for d in 16x16 22x22 24x24 32x32 48x48 256x256; do
        install -Dm644 "packaging/linux/icons/${d}/apps/mcomix3.png" \
            "${pkgdir}/usr/share/icons/hicolor/${d}/apps/mcomix3.png" 2>/dev/null || true
        for mime in application-x-cbz application-x-cbr application-x-cbt; do
            install -Dm644 "packaging/linux/icons/${d}/mimetypes/${mime}.png" \
                "${pkgdir}/usr/share/icons/hicolor/${d}/mimetypes/${mime}.png" 2>/dev/null || true
        done
    done
}

post_install() {
    update-desktop-database -q 2>/dev/null || true
    update-mime-database /usr/share/mime 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_upgrade() {
    post_install
}
